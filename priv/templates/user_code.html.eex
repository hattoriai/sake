<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Connect a device</title>
<style>
:root { --bg: #f7f7f5; --fg: #1b1b1a; --muted: #5f5e5a; --card: #ffffff; --line: #e4e3df; --accent: #2b6cb0; --accent-fg: #ffffff; --warn-bg: #fff6e5; --warn-fg: #6b4700; }
@media (prefers-color-scheme: dark) { :root { --bg: #151514; --fg: #ecebe7; --muted: #a3a29c; --card: #1f1f1d; --line: #33332f; --accent: #6aa4e6; --accent-fg: #0f172a; --warn-bg: #3a2c0a; --warn-fg: #ffd77a; } }
html { background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; }
body { margin: 0; padding: 16px; }
main { max-width: 480px; margin: 48px auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 24px; }
h1 { font-size: 1.25rem; margin: 0 0 8px; }
p { margin: 0 0 12px; }
.muted { color: var(--muted); font-size: 0.9rem; }
.warn { background: var(--warn-bg); color: var(--warn-fg); border-radius: 8px; padding: 10px 12px; margin: 12px 0; font-size: 0.9rem; }
form { display: flex; flex-direction: column; gap: 12px; margin-top: 16px; }
input[type=text] { padding: 10px 12px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--fg); font: 1.25rem/1.2 ui-monospace, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
button { padding: 10px 14px; border-radius: 8px; border: 1px solid var(--accent); background: var(--accent); color: var(--accent-fg); font: inherit; cursor: pointer; }
</style>
</head>
<body>
<main>
<h1>Connect a device to <%= Plug.HTML.html_escape(@issuer_name) %></h1>
<p>Signed in as <strong><%= Plug.HTML.html_escape(@subject_display) %></strong>.</p>
<p class="muted">Enter the code your device shows. Only enter a code from a device you are setting up yourself.</p>
<%= if @error do %><div class="warn"><%= Plug.HTML.html_escape(@error) %></div><% end %>
<form method="post" action="<%= Plug.HTML.html_escape(@action) %>">
<input type="hidden" name="_csrf_token" value="<%= Plug.HTML.html_escape(@csrf_token) %>">
<input type="hidden" name="request" value="<%= Plug.HTML.html_escape(@request) %>">
<input type="text" name="user_code" value="<%= Plug.HTML.html_escape(@user_code) %>" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Code" placeholder="XXXX-XXXX" required>
<button type="submit">Continue</button>
</form>
</main>
</body>
</html>
